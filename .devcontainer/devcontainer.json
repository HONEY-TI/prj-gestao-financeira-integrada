{
  "name": "prj-gestao-integrada",
  "features": { "ghcr.io/devcontainers/features/docker-in-docker:2": {} },
  "dockerComposeFile": [ "docker-compose.yml" ],
  "service": "prj-gestao-integrada",
  "workspaceFolder": "/workspace",
  "remoteUser": "ubuntu",
  "updateRemoteUserUID": true,
  "overrideCommand": false,
  "postCreateCommand": "tool-install.sh",
  "waitFor": "postCreateCommand",
  "postStartCommand": "start.sh",
  "shutdownAction": "stopCompose",
  "containerEnv": {
    "DISPLAY": "${localEnv:DISPLAY::0}",
    "XAUTHORITY": "/tmp/.xauth-devc",
    "VSCODE_IPC_HOOK_CLI": "${localEnv:VSCODE_IPC_HOOK_CLI}"
  },/*
  "remoteEnv": {
    "DOCKER_HOST": "unix:///var/run/docker.sock"
  },*/
  "mounts": [
    "source=/var/run/docker.sock,target=/var/run/docker.sock,type=bind",
    "source=/tmp/.X11-unix,target=/tmp/.X11-unix,type=bind",
    "source=${localWorkspaceFolder}/.cache/.xauth-devc,target=/tmp/.xauth-devc,type=bind",
    "type=volume,target=/home/ubuntu/.vscode-server",
    "source=${localEnv:HOME}/.ssh,target=/home/ubuntu/.ssh,type=bind"
  ],
  "otherPortsAttributes": {
    "onAutoForward": "ignore"
  },
  "forwardPorts": [
    17015,
    7309,
    6379,
    15183,
    5488,
    46233,
    41555,
    35923
  ],
  "portsAttributes": {
    "17015": {
      "label": "Aspire HTTPS",
      "onAutoForward": "notify"
    },
    "15183": {
      "label": "Aspire HTTP",
      "onAutoForward": "notify"
    },
    "7309": {
      "label": "AppServer HTTPS",
      "onAutoForward": "notify"
    },
    "5488": {
      "label": "AppServer HTTP",
      "onAutoForward": "notify"
    }
  },
  "customizations": {
    "vscode": {
      "extensions": [
        // --- .NET / C# / Aspire ---
        "ms-dotnettools.csdevkit",
        "ms-dotnettools.csharp",
        "ms-dotnettools.vscode-dotnet-runtime",
        "microsoft-aspire.aspire-vscode",
        "patcx.vscode-nuget-gallery",
        "kreativ-software.csharpextensions",
        "ms-azuretools.vscode-containers",
        // --- Angular / TypeScript ---
        "Angular.ng-template",
        "alexiv.vscode-angular2-files@1.6.4",
        "infinity1207.angular2-switcher@0.4.0",
        "john-crowson.angular-file-changer@0.0.4",
        "natewallace.angular2-inline@0.0.17",
        "hardikpthv.ngrxsnippets@9.1.0",
        "baflo.jasminesnippetsts@1.3.0",
        "mattpocock.ts-error-translator@0.10.1",
        "ms-vscode.vscode-typescript-next@6.0.20260416",
        "typescriptteam.native-preview@0.20260611.2",
        "dskwrk.vscode-generate-getter-setter@0.5.0",
        // --- Lint / formatação ---
        "dbaeumer.vscode-eslint",
        "esbenp.prettier-vscode",
        "inferrinizzard.prettier-sql-vscode@1.6.0",
        // --- Git ---
        "eamodio.gitlens@19.0.1",
        "donjayamanne.githistory@0.6.20",
        "arturock.gitstash@6.13.0",
        // --- Markdown / docs ---
        "yzhang.markdown-all-in-one@3.6.3",
        "shd101wyy.markdown-preview-enhanced@0.8.30",
        "bierner.markdown-mermaid@1.32.1",
        // --- IA / produtividade ---
        "openai.chatgpt@26.810.52044",
        // --- Visual / utilitários ---        
        "ms-dotnettools.csdevkit",
        "Angular.ng-template",
        "openai.chatgpt@26.810.52044",
        "dbaeumer.vscode-eslint",
        "esbenp.prettier-vscode",
        "alexiv.vscode-angular2-files@1.6.4",
        "anseki.vscode-color@0.4.5",
        "baflo.jasminesnippetsts@1.3.0",
        "bierner.emojisense@0.10.0",
        "bierner.markdown-checkbox@0.4.0",
        "dbaeumer.vscode-eslint@3.0.24",
        "dskwrk.vscode-generate-getter-setter@0.5.0",
        "dzhavat.bracket-pair-toggler@0.0.3",
        "ibm.output-colorizer@0.1.2",
        "inferrinizzard.prettier-sql-vscode@1.6.0",
        "infinity1207.angular2-switcher@0.4.0",
        "john-crowson.angular-file-changer@0.0.4",
        "mattpocock.ts-error-translator@0.10.1",
        "ms-vscode.vscode-typescript-next@6.0.20260416",
        "natewallace.angular2-inline@0.0.17",
        "naumovs.color-highlight@2.8.0",
        "oderwat.indent-rainbow@8.3.1",
        "pkosta2006.rxjs-snippets@0.0.2",
        "shd101wyy.markdown-preview-enhanced@0.8.30",
        "typescriptteam.native-preview@0.20260611.2",
        "yzhang.markdown-all-in-one@3.6.3",
        "arturock.gitstash@6.13.0",
        "donjayamanne.githistory@0.6.20",
        "arturock.gitstash@6.13.0",
        "eamodio.gitlens@19.0.1"
      ]
    }
  }
}