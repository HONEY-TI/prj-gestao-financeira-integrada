{
  "name": "prj-gestao-integrada",
  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:2": {}
  },
  "dockerComposeFile": ["docker-compose.yml"],
  "service": "prj-gestao-integrada",
  "workspaceFolder": "/workspace",
  "remoteUser": "ubuntu",
  "updateRemoteUserUID": true,
  "overrideCommand": false,
  "initializeCommand": "f=$(ls -t \"${XDG_RUNTIME_DIR}\"/.mutter-Xwaylandauth.* 2>/dev/null | head -n1); rm -rf .devcontainer/.xauth-devc; if [ -n \"$f\" ]; then cp \"$f\" .devcontainer/.xauth-devc; else : > .devcontainer/.xauth-devc; fi",
  "postCreateCommand": "bash setup-codex.sh ",
  "postStartCommand": "aspire certs trust",
  //"updateContentCommand": "setup-dev-certs.sh",
  "waitFor": "postCreateCommand",
  "containerEnv": {
    "IN_DEVCONTAINER": "true",
    "DISPLAY": "${localEnv:DISPLAY::0}",
    "XAUTHORITY": "/tmp/.xauth-devc",
    "VSCODE_IPC_HOOK_CLI": "${localEnv:VSCODE_IPC_HOOK_CLI}"
  },
  "mounts": [
    "source=/tmp/.X11-unix,target=/tmp/.X11-unix,type=bind",
    "source=${localWorkspaceFolder}/.devcontainer/.xauth-devc,target=/tmp/.xauth-devc,type=bind,readonly",
    "type=volume,target=/home/ubuntu/.vscode-server",
    "source=${localEnv:HOME}/.ssh,target=/home/ubuntu/.ssh,type=bind"
  ],
  "forwardPorts": [17015, 7309, 15183, 5488, 46233, 41555, 35923],
  "customizations": {
    "vscode": {
      "dev.containers.executeInWSL": true,
      "dev.containers.executeInWSLDistro": "Ubuntu",
      "extensions": [
        "ms-dotnettools.csdevkit",
        "Angular.ng-template",
        "openai.chatgpt@26.810.52044",
        "dbaeumer.vscode-eslint",
        "esbenp.prettier-vscode",
        "alefragnani.bookmarks@14.1.1",
        "alexiv.vscode-angular2-files@1.6.4",
        "anseki.vscode-color@0.4.5",
        "baflo.jasminesnippetsts@1.3.0",
        "bierner.emojisense@0.10.0",
        "bierner.markdown-checkbox@0.4.0",
        "dbaeumer.vscode-eslint@3.0.24",
        "dskwrk.vscode-generate-getter-setter@0.5.0",
        "dzhavat.bracket-pair-toggler@0.0.3",
        "hardikpthv.ngrxsnippets@9.1.0",
        "ibm.output-colorizer@0.1.2",
        "inferrinizzard.prettier-sql-vscode@1.6.0",
        "infinity1207.angular2-switcher@0.4.0",
        "john-crowson.angular-file-changer@0.0.4",
        "mathematic.vscode-pdf@0.1.11",
        "mattpocock.ts-error-translator@0.10.1",
        "ms-vscode.vscode-typescript-next@6.0.20260416",
        "natewallace.angular2-inline@0.0.17",
        "naumovs.color-highlight@2.8.0",
        "oderwat.indent-rainbow@8.3.1",
        "pkosta2006.rxjs-snippets@0.0.2",
        "shd101wyy.markdown-preview-enhanced@0.8.30",
        "typescriptteam.native-preview@0.20260611.2",
        "visualstudioexptteam.intellicode-api-usage-examples@0.2.9",
        "visualstudioexptteam.vscodeintellicode@1.3.2",
        "yzhang.markdown-all-in-one@3.6.3",
        "arturock.gitstash@6.13.0",
        "donjayamanne.githistory@0.6.20",
        "arturock.gitstash@6.13.0",
        "eamodio.gitlens@19.0.1",
        "bierner.markdown-mermaid@1.32.1"
      ]
    }
  }
}
