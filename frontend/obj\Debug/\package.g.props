<?xml version="1.0" encoding="utf-8"?>
<Project>
  <PropertyGroup>
    <PackageJsonName Condition="$(PackageJsonName) == ''">despesas-frontend</PackageJsonName>
    <PackageJsonVersion Condition="$(PackageJsonVersion) == ''">5.0.0</PackageJsonVersion>
    <PackageJsonType Condition="$(PackageJsonType) == ''">module</PackageJsonType>
    <PackageJsonWorkspaces Condition="$(PackageJsonWorkspaces) == ''">[
  "app-ios",
  "app-android"
]</PackageJsonWorkspaces>
    <PackageJsonScriptsStart Condition="$(PackageJsonScriptsStart) == ''">NG_FORCE_TTY=false ng serve --configuration production</PackageJsonScriptsStart>
    <PackageJsonScriptsDev Condition="$(PackageJsonScriptsDev) == ''">cross-env-shell "ng serve --port $PORT"</PackageJsonScriptsDev>
    <PackageJsonScriptsBuild Condition="$(PackageJsonScriptsBuild) == ''">ng build --configuration development</PackageJsonScriptsBuild>
    <PackageJsonScriptsBuildDev Condition="$(PackageJsonScriptsBuildDev) == ''">ng build --configuration development</PackageJsonScriptsBuildDev>
    <PackageJsonScriptsLint Condition="$(PackageJsonScriptsLint) == ''">eslint .</PackageJsonScriptsLint>
    <PackageJsonScriptsWatch Condition="$(PackageJsonScriptsWatch) == ''">ng build --watch --configuration development</PackageJsonScriptsWatch>
    <PackageJsonScriptsTest Condition="$(PackageJsonScriptsTest) == ''">set BROWSER=ChromeHeadless &amp;&amp; ng test --browsers=ChromeHeadless --no-watch</PackageJsonScriptsTest>
    <PackageJsonScriptsTestDebug Condition="$(PackageJsonScriptsTestDebug) == ''">set BROWSER=Chrome &amp;&amp; ng test --browsers=Chrome</PackageJsonScriptsTestDebug>
    <PackageJsonScriptsTestCoverage Condition="$(PackageJsonScriptsTestCoverage) == ''">ng test --code-coverage --browsers=ChromeHeadless --no-watch</PackageJsonScriptsTestCoverage>
    <PackageJsonScriptsTestWatch Condition="$(PackageJsonScriptsTestWatch) == ''">ng test --code-coverage --browsers=ChromeHeadless --watch</PackageJsonScriptsTestWatch>
    <PackageJsonScriptsBuildAndroid Condition="$(PackageJsonScriptsBuildAndroid) == ''">npm run build:mobile --workspace=app-android</PackageJsonScriptsBuildAndroid>
    <PackageJsonScriptsBuildAndroidDev Condition="$(PackageJsonScriptsBuildAndroidDev) == ''">npm run build:mobile-dev --workspace=app-android</PackageJsonScriptsBuildAndroidDev>
    <PackageJsonScriptsBuildIos Condition="$(PackageJsonScriptsBuildIos) == ''">npm run build:mobile --workspace=app-ios</PackageJsonScriptsBuildIos>
    <PackageJsonScriptsStartAndroid Condition="$(PackageJsonScriptsStartAndroid) == ''">npm run start:android --workspace=app-android</PackageJsonScriptsStartAndroid>
    <PackageJsonScriptsStartIos Condition="$(PackageJsonScriptsStartIos) == ''">npm run start:ios --workspace=app-ios</PackageJsonScriptsStartIos>
    <PackageJsonPrivate Condition="$(PackageJsonPrivate) == ''">true</PackageJsonPrivate>
    <PackageJsonDependenciesAngularAnimations Condition="$(PackageJsonDependenciesAngularAnimations) == ''">20.1.5</PackageJsonDependenciesAngularAnimations>
    <PackageJsonDependenciesAngularCdk Condition="$(PackageJsonDependenciesAngularCdk) == ''">^20.1.5</PackageJsonDependenciesAngularCdk>
