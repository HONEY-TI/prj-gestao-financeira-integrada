{
  "name": "despesas-frontend",
  "version": "5.0.0",
  "type": "module",
  "workspaces": [
    "app-ios",
    "app-android"
  ],
  "scripts": {
    "start": "NG_FORCE_TTY=false ng serve --configuration production",
    "dev": "cross-env-shell \"ng serve --port $PORT\"",
    "build": "NG_FORCE_TTY=false ng build --configuration production",
    "build:dev": "NG_FORCE_TTY=false ng build --configuration development",
    "lint": "eslint .",
    "watch": "NG_FORCE_TTY=false ng build --watch --configuration development",
    "test": "set BROWSER=ChromeHeadless && ng test --browsers=ChromeHeadless --no-watch",
    "test:debug": "set BROWSER=Chrome && ng test --browsers=Chrome",
    "test:coverage": "ng test --code-coverage --browsers=ChromeHeadless --no-watch",
    "test:watch": "ng test --code-coverage --browsers=ChromeHeadless --watch",
    "build:android": "npm run build:mobile --workspace=app-android",
    "build:android-dev": "npm run build:mobile-dev --workspace=app-android",
    "build:ios": "npm run build:mobile --workspace=app-ios",
    "start:android": "npm run start:android --workspace=app-android",
    "start:ios": "npm run start:ios --workspace=app-ios"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "22.2.6",
    "@angular/cdk": "22.2.6",
    "@angular/common": "22.2.6",
    "@angular/compiler": "22.2.6",
    "@angular/core": "22.2.6",
    "@angular/forms": "22.2.6",
    "@angular/material": "22.2.6",
    "@angular/material-moment-adapter": "22.2.6",
    "@angular/platform-browser": "22.2.6",
    "@angular/platform-browser-dynamic": "22.2.6",
    "@angular/router": "22.2.6",
    "@capacitor/core": "6.2.1",
    "@date-io/dayjs": "^3.2.0",
    "@ionic/angular": "^8.7.3",
    "@ng-bootstrap/ng-bootstrap": "21.0.0",
    "@popperjs/core": "^2.11.8",
    "angular-datatables": "^16.0.1",
    "bootstrap": "^5.3.7",
    "bootstrap-icons": "^1.13.1",
    "chart.js": "^4.5.0",
    "chartjs-plugin-datalabels": "^2.2.0",
    "datatables.net": "^1.13.7",
    "datatables.net-dt": "^1.13.7",
    "datatables.net-select": "^1.7.0",
    "datatables.net-select-dt": "^1.7.0",
    "dayjs": "^1.11.13",
    "jquery": "^3.7.1",
    "mdb-ui-kit": "^9.1.0",
    "moment": "^2.30.1",
    "ng2-charts": "^5.0.4",
    "ng2-currency-mask": "^13.0.3",
    "ngx-mask": "^20.0.3",
    "oidc-client-ts": "^3.5.0",
    "rxjs": "~7.8.2",
    "tslib": "^2.8.1",
    "zone.js": "~0.15.1"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "22.2.6",
    "@angular/build": "22.2.6",
    "@angular/cli": "22.2.6",
    "@angular/compiler-cli": "22.2.6",
    "@angular/localize": "22.2.6",
    "@types/bootstrap": "^5.2.10",
    "@types/jasmine": "~5.1.8",
    "@types/jquery": "^3.5.32",
    "@types/node": "^26.6.6",
    "@typescript-eslint/eslint-plugin": "^8.72.2",
    "@typescript-eslint/parser": "^8.72.2",
    "cross-env": "^10.1.0",
    "eslint": "^9.32.0",
    "jasmine-core": "~5.9.0",
    "karma": "~6.4.4",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.1",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "ts-evaluator": "^2.0.0"
  },
  "overrides": {
    "autoprefixer": "^10.4.5",
    "glob": "^14.0.5",
    "uuid": "^11.0.0",
    "@eslint/eslintrc": {
      "ajv": "^6.12.6",
      "ajv-keywords": "^3.5.2"
    },
    "oidc-client": {
      "serialize-javascript": "^7.1.3"
    },
    "tar": "^7.5.23",
    "rimraf": "^6.1.3",
    "minimatch": "^11.0.8"

  }
}
