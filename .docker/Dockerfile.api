FROM mcr.microsoft.com/dotnet/sdk:10.0 AS build
WORKDIR /src

COPY . .
RUN dotnet restore prj-gestao-financeira-integrada.Server/prj-gestao-financeira-integrada.Server.csproj
RUN dotnet publish prj-gestao-financeira-integrada.Server/prj-gestao-financeira-integrada.Server.csproj \
    --configuration Release \
    --no-restore \
    --output /app/publish

FROM mcr.microsoft.com/dotnet/aspnet:10.0 AS runtime
WORKDIR /app
ENV ASPNETCORE_HTTP_PORTS=8080
EXPOSE 8080
COPY --from=build /app/publish .
ENTRYPOINT ["dotnet", "prj-gestao-financeira-integrada.Server.dll"]
