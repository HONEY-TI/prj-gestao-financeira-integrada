<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="obj\Debug\net10.0\.NETCoreApp,Version=v10.0.AssemblyAttributes.cs" />
    <Compile Include="obj\Debug\net10.0\XUnit.Tests.AssemblyInfo.cs" />
    <Compile Include="obj\Debug\net10.0\XUnit.Tests.GlobalUsings.g.cs" />
    <Compile Include="obj\Release\net10.0\.NETCoreApp,Version=v10.0.AssemblyAttributes.cs" />
    <Compile Include="obj\Release\net10.0\XUnit.Tests.AssemblyInfo.cs" />
    <Compile Include="obj\Release\net10.0\XUnit.Tests.GlobalUsings.g.cs" />
  </ItemGroup>

  <ItemGroup>
    <None Include="obj\Debug\net10.0\XUnit.Tests.AssemblyInfoInputs.cache" />
    <None Include="obj\Debug\net10.0\XUnit.Tests.assets.cache" />
    <None Include="obj\Debug\net10.0\XUnit.Tests.csproj.AssemblyReference.cache" />
    <None Include="obj\Debug\net10.0\XUnit.Tests.csproj.CoreCompileInputs.cache" />
    <None Include="obj\Debug\net10.0\XUnit.Tests.csproj.FileListAbsolute.txt" />
    <None Include="obj\Debug\net10.0\XUnit.Tests.GeneratedMSBuildEditorConfig.editorconfig" />
    <None Include="obj\project.assets.json" />
    <None Include="obj\project.nuget.cache" />
    <None Include="obj\Release\net10.0\XUnit.Tests.AssemblyInfoInputs.cache" />
    <None Include="obj\Release\net10.0\XUnit.Tests.assets.cache" />
    <None Include="obj\Release\net10.0\XUnit.Tests.csproj.AssemblyReference.cache" />
    <None Include="obj\Release\net10.0\XUnit.Tests.GeneratedMSBuildEditorConfig.editorconfig" />
    <None Include="obj\XUnit.Tests.csproj.nuget.dgspec.json" />
    <None Include="obj\XUnit.Tests.csproj.nuget.g.props" />
    <None Include="obj\XUnit.Tests.csproj.nuget.g.targets" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Aspire.Hosting.Testing" Version="13.6.4" />
    <PackageReference Include="coverlet.collector" Version="10.1.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.1">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <Using Include="System.Net" />
    <Using Include="Microsoft.Extensions.DependencyInjection" />
    <Using Include="Aspire.Hosting.ApplicationModel" />
    <Using Include="Aspire.Hosting.Testing" />
    <Using Include="Xunit" />
  </ItemGroup>

</Project>
